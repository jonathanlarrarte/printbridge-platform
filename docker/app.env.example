# .env de Laravel para el stack de Docker -- copiar a docker/app.env (sin
# ".example") y completar. Los contenedores lo reciben via `env_file:` en
# docker-compose.yml; el .env.example de la raiz del repo es el de
# desarrollo local sin Docker y no se usa aca.
#
# DB_PASSWORD y REDIS_PASSWORD tienen que ser EXACTAMENTE los mismos
# valores que pusiste en docker/compose.env -- ahi es donde se crean esas
# credenciales dentro de los contenedores de postgres/redis.

APP_NAME=PrintBridge
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=UTC
# El dominio/subdominio real donde va a vivir este deploy -- afecta URLs
# firmadas, CORS, y las que arma el frontend (resources/js/api.js usa
# rutas relativas, pero Sanctum/CSRF sí dependen de esto).
APP_URL=https://CAMBIAR-ESTE-DOMINIO

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=json
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# "warning" para este deploy nuevo, no "debug" como quedo en el servidor
# viejo por descuido -- bajalo temporalmente mientras validas la migracion
# si hace falta mas detalle, pero no lo dejes asi en el tiempo.
LOG_LEVEL=warning

# Clave propia de ESTE ambiente -- NUNCA copiar la del servidor actual.
# Generarla recien levantado el contenedor: ver docker/README.md.
APP_KEY=

DB_CONNECTION=pgsql
# Nombre del servicio en docker-compose.yml (DNS interno de Docker), no una IP.
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=printbridge_platform
DB_USERNAME=printbridge
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

API_VERSION=0.1.0

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=
