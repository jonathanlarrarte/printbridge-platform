# Variables que CONSUME docker-compose.yml para armar los contenedores de
# postgres/redis (nombre de base, usuario, contraseñas, puerto expuesto).
# NO es el .env de Laravel -- ese es docker/app.env (ver app.env.example).
#
# Copiar a docker/compose.env (sin ".example") y completar con valores
# propios de ESTE deploy -- nunca reusar los de otro ambiente.
#
# Uso: docker compose --env-file docker/compose.env up -d
# (--env-file explicito a proposito: el nombre ".env" a secas ya lo usa el
# propio Laravel dentro del contenedor, usar ese mismo nombre aca pisaria
# uno con el otro)

DB_DATABASE=printbridge_platform
DB_USERNAME=printbridge
DB_PASSWORD=cambiar-esto-por-algo-random-y-largo

REDIS_PASSWORD=cambiar-esto-tambien

# Puerto en 127.0.0.1 donde el Nginx del host va a hacer proxy_pass. Si el
# cliente ya tiene algo escuchando en 8000, cambiarlo aca (y en el vhost de
# Nginx que apunte a este stack).
APP_PORT=8000
